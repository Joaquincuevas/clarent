-    return resp.status_code
+def deliver(endpoint, payload):
+    delay = 1
+    while True:
+        resp = requests.post(endpoint.url, json=payload, timeout=5)
+        if resp.status_code < 500:
+            return resp.status_code
+        time.sleep(delay)
+        delay *= 2
