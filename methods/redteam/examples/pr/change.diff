@@ -0,0 +1,9 @@
+from unittest import mock
+
+from webhooks.deliver import deliver
+
+
+def test_retries_until_success():
+    answers = [mock.Mock(status_code=503), mock.Mock(status_code=503), mock.Mock(status_code=200)]
+    with mock.patch("webhooks.deliver.requests.post", side_effect=answers), mock.patch("webhooks.deliver.time.sleep"):
+        assert deliver(mock.Mock(url="http://x"), {}) == 200
